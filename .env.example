# Aegyptus Labyrinth — Environment Configuration
# Copy to .env and edit values for your setup.

# === Corpus Database ===
# PostgreSQL with the Aegyptus corpus (77k texts, 460k sentences).
# Default matches the included docker-compose.yml.
POSTGRES_PASSWORD=dev  # Change in production
DATABASE_URL=postgresql://aegyptus:dev@localhost:5434/aegyptus

# === Redis ===
REDIS_PASSWORD=dev  # Change in production

# === BFS Server ===
# The Babel File System spatial server. Rust TUI connects here.
BFS_PORT=8081
BFS_URL=http://localhost:8081/rpc

# === LLM Backend (Librarian NPC) ===
# Any OpenAI-compatible endpoint. The Librarian is optional — the game
# runs without it, but you lose the AI companion.
# Examples: ollama (localhost:11434), llama-server, vllm, together.ai
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL=hermes3:8b
LLM_API_KEY=

# === Scribe (Article Generation) — optional ===
# The Scribe synthesizes gathered texts into scholarly articles.
# Default uses Nous Research Portal with Kimi K2-thinking.
# Any OpenAI-compatible API works. Fallback chain: primary → kimi-k2.6 → kimi-k2-0905.
SCRIBE_API_BASE=https://inference-api.nousresearch.com/v1
SCRIBE_MODEL=moonshotai/kimi-k2-thinking
SCRIBE_API_KEY=

# === hermes-agent (optional) ===
# Path to hermes-agent installation for the Librarian NPC bridge.
# See docs/HERMES_INTEGRATION_SPEC.md for setup instructions.
# Leave blank if hermes-agent is already on your Python path.
HERMES_AGENT_PATH=
HERMES_PYTHON=python3

# === Paths ===
# STACKS_ROOT is auto-detected from the Cargo workspace. Override only
# if running the binary from outside the repo.
# STACKS_ROOT=
# ARTICLES_DIR=./articles
